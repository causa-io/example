{
  "name": "ordering-service",
  "version": "0.1.0",
  "description": "The main service for the Ordering domain.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "rimraf ./dist",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules --no-warnings=ExperimentalWarning\" GOOGLE_APPLICATION_CREDENTIALS= jest",
    "test:cov": "npm run test -- --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@causa/runtime": "^2.1.1",
    "@causa/runtime-google": "^2.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "firebase": "^12.18.0",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
