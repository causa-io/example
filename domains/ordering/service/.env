# Environment variables for local runs and tests.
#
# Everything the emulators provide (hosts, ports, the local GCP project, Pub/Sub topics, ...) comes from
# `.causa/emulators.env`, written at the workspace root by `cs emulators start`. See `jest.config.mjs`.
# This file only holds what the emulators cannot provide, or what this service overrides.

# The Spanner emulator sets `SPANNER_DATABASE` to every database found in the workspace (`catalog|ordering`).
# This service only uses its own database, so it overrides the value here.
SPANNER_DATABASE=ordering

# Prevents the Google client libraries from trying to reach the GCE metadata server.
METADATA_SERVER_DETECTION=none
